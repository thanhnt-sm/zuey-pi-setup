// TypeSafe Planner Integration Extension for OMP
// Connects OMP planning workflows with TypeSafe System One judgments (Choice, Noul, Score).

interface ExtensionToolResult {
  content: Array<{ type: "text"; text: string }>;
  details?: unknown;
}

interface ToolDefinition<TParams> {
  name: string;
  label?: string;
  description: string;
  parameters: unknown;
  execute: (
    toolCallId: string,
    params: TParams,
    signal?: AbortSignal,
    onUpdate?: (result: ExtensionToolResult) => void,
    ctx?: unknown
  ) => Promise<ExtensionToolResult>;
}

interface ExtensionAPI {
  zod: {
    object: (shape: Record<string, unknown>) => unknown;
    union: (options: unknown[]) => unknown;
    string: () => unknown;
    record: (valueType: unknown) => unknown;
    enum: (values: string[]) => unknown;
    unknown: () => unknown;
  };
  on: (event: string, handler: (event: unknown, ctx: unknown) => Promise<void> | void) => void;
  registerTool: (definition: ToolDefinition<TypeSafeJudgeParams>) => void;
  sendMessage: (
    message: string | { customType?: string; content: string; display?: boolean },
    options?: { deliverAs?: "steer" | "followUp" | "nextTurn" | "aside"; triggerTurn?: boolean }
  ) => Promise<void>;
}

interface TypeSafeQuestion {
  type: "noul" | "choice" | "score";
  instructions: string | Record<string, unknown>;
  criteria?: unknown;
}

interface TypeSafeJudgeParams {
  state: string | Record<string, unknown>;
  questions: Record<string, TypeSafeQuestion>;
}

export default function (pi: ExtensionAPI): void {
  const apiKey = process.env.TYPESAFE_API_KEY?.trim();
  if (!apiKey) {
    return;
  }

  let enabled = false;
  const z = pi.zod;

  const PROMPT_INJECTION =
    "TypeSafe System One API is available. You have a `typesafe_judge` tool that sends state and typed questions (noul, choice, score) to Jev for fast structured judgments. Use it during scope challenge (classify scope mode), plan validation (check assumptions), or risk assessment (score complexity/risk). If the tool returns an error, proceed with your own analysis — TypeSafe is optional enrichment.";

  // Probe API availability on session start
  pi.on("session_start", async (_event: unknown, _ctx: unknown) => {
    try {
      const probeSignal = AbortSignal.timeout(2000);
      const res = await fetch("https://api.typesafe.ai/v1/models", {
        method: "GET",
        headers: {
          Authorization: `Bearer ${apiKey}`,
        },
        signal: probeSignal,
      });

      if (res.status === 200) {
        enabled = true;
        try {
          await pi.sendMessage(
            {
              customType: "typesafe-planner",
              content: PROMPT_INJECTION,
              display: true,
            },
            { deliverAs: "nextTurn" }
          );
        } catch {
          try {
            await pi.sendMessage(PROMPT_INJECTION, { deliverAs: "nextTurn" });
          } catch {
            // Non-critical notification failure
          }
        }
      } else {
        enabled = false;
      }
    } catch {
      enabled = false;
    }
  });

  // Register LLM-callable tool
  pi.registerTool({
    name: "typesafe_judge",
    label: "TypeSafe Judge",
    description:
      "Send state and structured questions (noul, choice, score) to TypeSafe System One for fast structured judgments.",
    parameters: z.object({
      state: z.union([z.string(), z.record(z.unknown())]),
      questions: z.record(
        z.object({
          type: z.enum(["noul", "choice", "score"]),
          instructions: z.union([z.string(), z.record(z.unknown())]),
          criteria: z.unknown().optional(),
        })
      ),
    }),
    async execute(
      _toolCallId: string,
      params: TypeSafeJudgeParams,
      signal?: AbortSignal,
      _onUpdate?: (result: ExtensionToolResult) => void,
      _ctx?: unknown
    ): Promise<ExtensionToolResult> {
      if (!enabled) {
        return {
          content: [
            {
              type: "text",
              text: "TypeSafe API unavailable; skipping judgment.",
            },
          ],
        };
      }

      try {
        const fetchSignal = signal
          ? AbortSignal.any([signal, AbortSignal.timeout(10_000)])
          : AbortSignal.timeout(10_000);

        const res = await fetch("https://api.typesafe.ai/v1/systemone", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${apiKey}`,
          },
          body: JSON.stringify({
            state: params.state,
            model: "jev-latest",
            questions: params.questions,
          }),
          signal: fetchSignal,
        });

        if (res.status === 401) {
          enabled = false;
          return {
            content: [
              {
                type: "text",
                text: "TypeSafe API error: 401 Unauthorized. Key invalid; disabling TypeSafe judgments.",
              },
            ],
          };
        }

        if (!res.ok) {
          const errText = await res.text().catch(() => "");
          return {
            content: [
              {
                type: "text",
                text: `TypeSafe API error (${res.status}): ${errText || res.statusText}`,
              },
            ],
          };
        }

        const data: unknown = await res.json();
        return {
          content: [{ type: "text", text: JSON.stringify(data, null, 2) }],
          details: data,
        };
      } catch (err: unknown) {
        const isAbort =
          err instanceof Error &&
          (err.name === "TimeoutError" || err.name === "AbortError");
        if (isAbort) {
          return {
            content: [
              {
                type: "text",
                text: "TypeSafe API request timed out after 10s.",
              },
            ],
          };
        }
        const message = err instanceof Error ? err.message : String(err);
        return {
          content: [
            {
              type: "text",
              text: `TypeSafe API network error: ${message}`,
            },
          ],
        };
      }
    },
  });
}
