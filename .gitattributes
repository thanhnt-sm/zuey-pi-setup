# Enforce consistent LF line endings across Windows Git Bash, Linux, and macOS
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.example text eol=lf
*.bat text eol=crlf
*.ps1 text eol=lf
*.tar.gz binary
*.png binary
